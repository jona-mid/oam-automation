# Copy to .env (gitignored) and fill in. oam_weekly.py and aerialmodel_weekly.py load it automatically.

# VLM check via OpenRouter (model google/gemini-3-flash-preview)
OPENROUTER_API_KEY=

# deadtrees.earth platform account used for the uploads (read by deadtrees-cli)
PROCESSOR_USERNAME=
PROCESSOR_PASSWORD=
SUPABASE_URL=
SUPABASE_KEY=
API_ENDPOINT=

# Upload ledger: one row per uploaded file, used for dedup and appended after each upload
OAM_UPLOADED_CSV=/mnt/gsdata/projects/deadtrees/data_openaerialmap/metadata_uploaded.csv

# aerialmodel.com source (aerialmodel_weekly.py): account for the orthophoto downloads, and its own ledger
AERIALMODEL_EMAIL=
AERIALMODEL_PASSWORD=
AERIALMODEL_UPLOADED_CSV=/mnt/gsdata/projects/deadtrees/data_aerialworld/metadata_uploaded.csv
